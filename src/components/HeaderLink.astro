---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL.slice(0, -1)
	: import.meta.env.BASE_URL;
const baseUrl = `${basePath}/`;
const pathnameWithoutBase = Astro.url.pathname.startsWith(basePath)
	? Astro.url.pathname.slice(basePath.length)
	: Astro.url.pathname;
const pathname = pathnameWithoutBase.startsWith('/') ? pathnameWithoutBase : `/${pathnameWithoutBase}`;
const hrefPath =
	typeof href === 'string' ? (href.startsWith(basePath) ? href.slice(basePath.length) || '/' : href) : '';
const resolvedHref =
	typeof href === 'string' && href.startsWith('/')
		? `${baseUrl}${href.replace(/^\/+/, '')}`
		: href;
const subpath = pathname.match(/[^\/]+/g);
const isActive = hrefPath === pathname || hrefPath === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
